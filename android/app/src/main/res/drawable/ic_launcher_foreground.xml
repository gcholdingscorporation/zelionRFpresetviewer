<?xml version="1.0" encoding="utf-8"?>
<!--
  A three-blade rotor head in the Configurator's accent blue.

  Vector only, so the project carries no binary image assets at all. The blades
  stay inside the 72dp safe zone of the 108dp adaptive-icon canvas, so a
  circular or squircle launcher mask does not clip them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="0">
        <path
            android:fillColor="#4DA8DA"
            android:pathData="M54,50 L86,46 L86,56 L54,58 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="120">
        <path
            android:fillColor="#4DA8DA"
            android:pathData="M54,50 L86,46 L86,56 L54,58 Z" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="240">
        <path
            android:fillColor="#4DA8DA"
            android:pathData="M54,50 L86,46 L86,56 L54,58 Z" />
    </group>

    <!-- Rotor hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,42 A12,12 0 1,1 53.99,42 Z" />
    <path
        android:fillColor="#3D3F3E"
        android:pathData="M54,48 A6,6 0 1,1 53.99,48 Z" />
</vector>
